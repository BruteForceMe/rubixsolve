{
  "name": "rubiks-cube-solver",
  "version": "1.0.0",
  "description": "Rubik's Cube Solver with 3D Three.js frontend and Express C++ IDA* backend",
  "scripts": {
    "dev": "node dev-runner.js",
    "start": "node dev-runner.js",
    "backend": "node backend/server.js",
